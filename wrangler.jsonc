{
  // Cloudflare Pages project (connected to this repo). Static form in ./public, Functions in ./functions.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "websquire-custom-site-form",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-01",

  // The email Worker in ./worker, deployed separately with `npm run deploy:worker`.
  "services": [{ "binding": "BRIEF", "service": "websquire-brief" }]
}
