{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "websquire-brief",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "15c0ed37096745bbf79320d99b111039",
  "observability": { "enabled": true },

  // Only reachable through the Pages project's service binding.
  "workers_dev": false,
  "preview_urls": false,

  // Per-IP cap on submissions so the endpoint can't be used to flood the CRM.
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "4271", "simple": { "limit": 5, "period": 60 } }
  ],

  // WEBHOOK_URL (the LeadConnector inbound webhook) is a secret:
  //   npx wrangler secret put WEBHOOK_URL -c worker/wrangler.jsonc
  "secrets": { "required": ["WEBHOOK_URL"] },

  "vars": {
    // Comma-separated origins allowed to POST from another site (e.g. "https://web-squire.com").
    // Leave empty when the form is only served by the Pages project.
    "ALLOWED_ORIGINS": ""
  }
}
